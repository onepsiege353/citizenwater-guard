{
  "name": "citizenwater-guard-frontend",
  "version": "1.0.0",
  "expo": {
    "name": "CitizenWater Guard",
    "slug": "citizenwater-guard",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "citizenwater",
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndPermission": "grantWhenInUse",
          "locationWhenInUsePermission": "Allow $(PRODUCT_NAME) to access your location while the app is in use?"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptiveForeground.png",
        "backgroundImage": "./assets/adaptiveBackground.png"
      }
    }
  },
  "dependencies": {
    "@react-native-community/geolocation": "^3.4.0",
    "@react-native-community/masked-view": "^0.1.11",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.2",
    "expo-linear-gradient": "^57.0.2",
    "react-native-safe-area-context": "^5.10.0",
    "react-native-screens": "^4.28.0"
  }
}
